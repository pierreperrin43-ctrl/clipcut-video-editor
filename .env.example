# video-editor — environment variables
# Copy this file to ".env" and fill in only what you need. .env is gitignored — never commit it.
# The CORE pipeline (rough-cut, graphics, captions, music) needs NONE of these. They're all optional.

# Speaker labels for rough-cut --diarize (multi-speaker footage).
# Get a token at https://huggingface.co/settings/tokens and accept the terms at
# https://huggingface.co/pyannote/speaker-diarization-3.1
# HUGGINGFACE_TOKEN=

# Only if you keep your WhisperX model cache somewhere custom, or want to point at an
# existing venv. Default location is ~/.cache/video-editor/whisperx-venv (auto-built).
# VIDEO_EDITOR_WHISPERX_VENV=

# Only if you run the captions/build scripts from outside the repo and the auto-detected
# repo root is wrong. Normally you never need this.
# VIDEO_EDITOR_REPO=

# Lip-sync a re-recorded line onto existing footage (workflows/sync-so.py; paid, per second).
# Get an API key at sync.so. The tool reads it from the environment or from this file.
# SYNC_API_KEY=
